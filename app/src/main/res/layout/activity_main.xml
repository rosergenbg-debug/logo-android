<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/logo_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Лого"
            android:textColor="@color/logo_black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/app_subtitle"
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E7E2DA"
            android:gravity="center"
            android:padding="12dp"
            android:text="Готово"
            android:textColor="@color/logo_black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Микрофон"
            android:textColor="@color/logo_black"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/inputSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/logo_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Вывод в наушники"
            android:textColor="@color/logo_black"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/outputSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/logo_black" />

        <TextView
            android:id="@+id/connectionModeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Аудиотракт: —"
            android:textColor="#5F6368"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Обновить список устройств"
            android:textColor="@color/logo_black"
            app:strokeColor="@color/logo_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EDE9E2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Калибровка реальной задержки"
                android:textColor="@color/logo_black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calibrationValueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Базовая задержка: не измерена"
                android:textColor="@color/logo_black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalDelayText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Итого: неизвестно"
                android:textColor="#5F6368" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Для измерения выньте один наушник и приложите его звуководом вплотную к микрофону телефона. В тихом месте нажмите «Калибровать». Прозвучат 4 коротких сигнала."
                android:textColor="#5F6368"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="КАЛИБРОВАТЬ"
                android:textColor="@color/logo_black"
                app:backgroundTint="@color/logo_yellow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Добавленная задержка"
                android:textColor="@color/logo_black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/delayValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75 мс"
                android:textColor="@color/logo_black"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/delaySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="15"
            android:progressTint="@color/logo_yellow"
            android:thumbTint="@color/logo_black" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick0"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick50"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="50" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick75"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="75" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick100"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="100" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick125"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="125" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quick150"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Громкость возврата"
                android:textColor="@color/logo_black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/volumeValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="@color/logo_black"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80"
            android:progressTint="@color/logo_yellow"
            android:thumbTint="@color/logo_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="СТАРТ"
                android:textColor="@color/logo_black"
                android:textStyle="bold"
                app:backgroundTint="@color/logo_yellow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="СТОП"
                android:textStyle="bold"
                app:backgroundTint="@color/logo_black" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Профили"
            android:textColor="@color/logo_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/profileSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveProfileButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Сохранить" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/applyProfileButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="Применить" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteProfileButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Удалить" />
        </LinearLayout>

        <TextView
            android:id="@+id/technicalInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#EDE9E2"
            android:padding="12dp"
            android:text="После калибровки здесь будет видна базовая Bluetooth-задержка. Значение DAF выше добавляется поверх неё."
            android:textColor="#5F6368"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Лого 1.1 • локальная обработка • без записи голоса"
            android:textColor="#777777"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
